FROM node:20-alpine AS dev

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ .

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]


# Static build of the admin SPA. The production stack copies /app/dist into a
# volume that Caddy serves — see the frontend-build service in
# docker-compose.prod.yml.
FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

CMD ["sh", "-c", "rm -rf /srv/* && cp -R /app/dist/. /srv/"]
