FROM node:20-alpine AS embed-build

WORKDIR /embed

COPY embed/package*.json ./
RUN npm ci

COPY embed/ .
RUN npm run build


FROM python:3.12-slim AS base

WORKDIR /app

# Install system deps for asyncpg and other compiled packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml and create a stub package so pip can install deps
# with layer caching before the full source is copied
COPY backend/pyproject.toml ./
RUN mkdir -p app && touch app/__init__.py && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

# Copy actual source (overwrites the stub)
COPY backend/ .

COPY VERSION /app/VERSION

# The embed bundle is served from /static — see EMBED_DIST_DIR in app/main.py
COPY --from=embed-build /embed/dist /app/embed-dist

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]


FROM base AS dev

RUN pip install --no-cache-dir ".[dev]"


FROM base AS production

RUN useradd -r app && chown -R app:app /app
USER app
