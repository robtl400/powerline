:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /webhooks/* {
        reverse_proxy backend:8000
    }
    handle /static/* {
        reverse_proxy backend:8000
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
