:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Body caps sit above the app's own limits (10 MB audio, 5 MB CSV) so
	# oversized uploads are cut off at the edge, with headroom for multipart
	# framing. Every other backend route takes JSON only.
	@audio_upload path /api/v1/audio/upload
	@target_import path /api/v1/campaigns/*/targets/import
	@backend_json {
		path /api/* /webhooks/* /static/* /docs* /openapi.json
		not path /api/v1/audio/upload /api/v1/campaigns/*/targets/import
	}

	request_body @audio_upload {
		max_size 12MB
	}
	request_body @target_import {
		max_size 6MB
	}
	request_body @backend_json {
		max_size 64KB
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /webhooks/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	# Same policy as Caddyfile.prod, minus HSTS (this listener is plain HTTP)
	# and with two relaxations the Vite dev server needs and production must
	# never have: 'unsafe-inline'/'unsafe-eval' scripts for the injected React
	# Refresh preamble, and ws: for the HMR socket.
	handle {
		header {
			X-Frame-Options DENY
			Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ws: wss:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self'"
		}
		reverse_proxy frontend:3000
	}
}
